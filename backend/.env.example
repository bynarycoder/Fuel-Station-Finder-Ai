# General
PROJECT_NAME="Fuel Station Finder AI"
ENVIRONMENT=development
PORT=8000

# Database (PostgreSQL + PostGIS)
# Sync connection (for migrations & sync tasks)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_station_db
# Async connection (for FastAPI endpoints)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fuel_station_db

# Supabase Credentials (for Auth and validation)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-signing-secret
# JWT verification (defaults shown). Keep SUPABASE_JWT_ALGORITHM as HS256 unless
# your Supabase project is configured for RS256. Set SUPABASE_JWT_AUDIENCE to
# "authenticated" to additionally require genuine user-session tokens.
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=

# AI APIs
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Report photo uploads (local storage)
MEDIA_DIR=media
MEDIA_URL=/media
MAX_UPLOAD_BYTES=5242880
