# General
PROJECT_NAME="Fuel Station Finder AI"
ENVIRONMENT=development
PORT=8000

# CORS: comma-separated allowed origins (set to your frontend URL in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (PostgreSQL + PostGIS)
# Sync connection (for migrations & sync tasks)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_station_db
# Async connection (for FastAPI endpoints)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fuel_station_db

# Supabase Credentials (the anon key is not a JWT signing secret)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Auth ES256/JWKS verification
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_JWT_AUDIENCE=authenticated
# Leave these blank to derive them from SUPABASE_URL, or set the exact values
# supplied by the Supabase project settings.
SUPABASE_JWT_ISSUER=https://your-supabase-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_CACHE_TTL_SECONDS=300

# AI APIs
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant

# Report photo uploads (local storage)
MEDIA_DIR=media
MEDIA_URL=/media
MAX_UPLOAD_BYTES=5242880
