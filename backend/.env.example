# General
PROJECT_NAME="Fuel Station Finder AI"
ENVIRONMENT=development
PORT=8000

# CORS: comma-separated allowed origins (set to your frontend URL in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (PostgreSQL + PostGIS)
# Sync connection (for migrations & sync tasks)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_station_db
# Async connection (for FastAPI endpoints)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fuel_station_db

# Supabase Credentials (the anon key is not a JWT signing secret)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Auth ES256/JWKS verification
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_JWT_AUDIENCE=authenticated
# Leave these blank to derive them from SUPABASE_URL, or set the exact values
# supplied by the Supabase project settings.
SUPABASE_JWT_ISSUER=https://your-supabase-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_CACHE_TTL_SECONDS=300

# AI APIs — two providers, two distinct responsibilities.
#
# GROQ = conversation + search intent + factual explanation
#   * POST /api/v1/ai/chat       -> general questions ("what can you help with?")
#   * POST /api/v1/ai/recommend  -> intent extraction + explanation for a
#                                   station search (the DB still ranks)
#   * GET  /api/v1/stations/search -> natural-language filter extraction
#   Without GROQ_API_KEY every one of these degrades to a deterministic
#   fallback that is LABELLED as such (answer_source="fallback").
#
# GEMINI = multimodal report-photo verification
#   * POST /api/v1/reports/{id}/verify (admin) -> score/is_plausible/summary
#   Without GEMINI_API_KEY the endpoint returns a clean 503.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# WARNING: gemini-1.5-flash was SHUT DOWN on 29 Sep 2025 and now 404s for every
# request. Use a currently supported multimodal model and re-check when Google
# retires a generation: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
# Per-call timeout for AI HTTP calls (seconds), SDK-level retry attempts for
# transient failures (set on the CLIENT constructor, never per request), and the
# in-memory TTL for computed AI recommendations. Optional; defaults shown.
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=1
AI_RECOMMEND_CACHE_TTL_SECONDS=300

# Report photo uploads (local storage)
MEDIA_DIR=media
MEDIA_URL=/media
MAX_UPLOAD_BYTES=5242880
